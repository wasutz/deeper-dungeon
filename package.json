{
  "name": "deeper-submission",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "friendsdk dev ./game",
    "build": "friendsdk build ./game --outdir dist",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs && node scripts/check-game.mjs",
    "check:games": "node scripts/check-game.mjs",
    "check:browser": "node scripts/check-browser.mjs",
    "tuning": "node scripts/tuning.mjs",
    "items": "node scripts/items.mjs",
    "verify": "node scripts/verify.mjs"
  },
  "dependencies": {
    "@rarefriends/friendsdk": "https://github.com/spokesz/friendsdk/releases/download/v0.1.2/rarefriends-friendsdk-0.1.2.tgz",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "typescript": "6.0.3",
    "playwright": "1.63.0",
    "viem": "2.56.3",
    "esbuild": "0.28.2"
  }
}
